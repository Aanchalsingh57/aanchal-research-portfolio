# Local development only. Never commit .env.
APP_ENV=development
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
DATABASE_URL=sqlite:///portfolio-dev.db
BASE_URL=http://127.0.0.1:8000
SITE_INDEXABLE=false
# Production must use APP_ENV=production, a PostgreSQL URL, and HTTPS BASE_URL.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Email notifications are optional. Messages are saved even without these settings.
MAIL_API_KEY=
MAIL_FROM=
MAIL_TO=
